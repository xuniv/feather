{
  "schemaVersion": 1,
  "defaultProvider": "litterbox",
  "providers": [
    {
      "id": "litterbox",
      "name": "Litterbox",
      "fileLimitBytes": 1000000000,
      "upload": {
        "url": "https://litterbox.catbox.moe/resources/internals/api.php",
        "fileField": "fileToUpload",
        "fields": {
          "reqtype": "fileupload"
        },
        "ipaFilename": "App.ipa",
        "manifestFilename": "install.xml",
        "response": {
          "format": "plainTextURL"
        },
        "ua": false
      },
      "download": {
        "hosts": [
          "litter.catbox.moe"
        ],
        "manifestMIMETypes": [
          "text/xml",
          "application/xml"
        ]
      },
      "options": [
        {
          "id": "retention",
          "label": "Retention",
          "defaultChoice": "1h",
          "choices": [
            {
              "id": "1h",
              "label": "1 hour",
              "fields": {
                "time": "1h"
              }
            },
            {
              "id": "12h",
              "label": "12 hours",
              "fields": {
                "time": "12h"
              }
            },
            {
              "id": "24h",
              "label": "24 hours",
              "fields": {
                "time": "24h"
              }
            },
            {
              "id": "72h",
              "label": "72 hours",
              "fields": {
                "time": "72h"
              }
            }
          ]
        }
      ]
    },
    {
