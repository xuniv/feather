// Numeric package version for iOS/AltStore compatibility; always increase.
FEATHER_PROJECT_VERSION=2.9.7
CURRENT_PROJECT_VERSION=$(FEATHER_PROJECT_VERSION)
// Public fork version. Bump the revision for each release, track upstream separately.
FEATHER_UPSTREAM_VERSION=2.9.0
FEATHER_FIX_VERSION=7
FEATHER_RELEASE_VERSION=$(FEATHER_UPSTREAM_VERSION)-$(FEATHER_FIX_VERSION)
FEATHER_PRODUCT_BUNDLE_IDENTIFIER=thewonderofyou.Feather
FEATHER_DISAMBIGUATOR=${DEVELOPMENT_TEAM}

AD_HOC_CODE_SIGNING_ALLOWED = YES

DEPLOYMENT_LOCATION = YES
DSTROOT = $(SRCROOT)/_build/
